# B&C Wedding OS — Environment Template
# Copy this to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
#
# ── Google OAuth2 ─────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (type: "Desktop app")
# 3. Enable APIs: Google Sheets API, Google Drive API, Gmail API
# 4. Paste the Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret_here

# Populated automatically by: npm run link:google
GOOGLE_REFRESH_TOKEN=

# ── Google Sheet IDs (pre-filled) ─────────────────────────────────────────
SHEETS_BUDGET_ID=1lwmu8dTuz4KtyX_lwsdGMzqJ6BM9mINafDmzdQd2t3w
SHEETS_ROOMING_ID=1WZbTwbJA36cdCqZmFrcaEYSdGyfCl1rPS7Vh8qa-nKs

# ── GitHub (optional — only needed if git auth isn't already configured) ──
# Generate at https://github.com/settings/tokens/new
# Scopes needed: repo (full), workflow
GITHUB_TOKEN=

# ── App settings ──────────────────────────────────────────────────────────
WEDDING_DATE=2026-06-17
FX_RATE_OVERRIDE=      # leave blank to fetch live rate
